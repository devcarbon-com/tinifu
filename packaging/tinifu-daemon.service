[Unit]
Description=tinifu speech-to-text daemon (Whistle via jolt.ffi)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/bin/tinifu-daemon
# Tray shim is found at ~/.local/lib/tinifu/libtinifu_sni.so (or $TINIFU_SHIM);
# no WorkingDirectory needed.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
