[Unit]
Description=tinifu speech-to-text daemon (Whistle via jolt.ffi)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/bin/tinifu-daemon
WorkingDirectory=%h/projects/tinifu
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
